# Local development only. Replace this placeholder in .env before starting PostgreSQL.
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=5432

# Backend and Prisma CLI connection. Keep password and port in sync with the settings above.
DATABASE_URL=postgresql://sgb_portal:replace-with-a-random-local-password@127.0.0.1:5432/sgb_portal

# Internal waitlist endpoints require both values. Keep disabled outside local development.
NODE_ENV=development
ENABLE_DEV_WAITLIST_ADMIN=false

# Local email delivery to Mailpit. No real messages leave the local inbox.
MAIL_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=sgb-portal@example.invalid
MAILPIT_UI_PORT=8025
# Public frontend origin used to construct status links; production requires explicit HTTPS.
PUBLIC_FRONTEND_URL=http://localhost:4200
# Optional SMTP credentials for a future provider; configure both together.
# SMTP_USER=
# SMTP_PASSWORD=
